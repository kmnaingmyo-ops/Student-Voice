# Copy to operator.env and keep it private and off the Render web service.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_voice
DB_SSL=false
OPERATOR_DB_USER=replace-with-operator-user
OPERATOR_DB_PASSWORD=replace-with-private-operator-password
# Generate separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Save this key in a protected password manager, separately from the backup file.
BACKUP_KEY=
