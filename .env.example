DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_voice
DB_USER=student_voice_app
DB_PASSWORD=replace-with-your-local-password
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# Set false after migrations are applied and a restricted runtime account is ready.
DB_AUTO_MIGRATE=true

# Firebase Web API key, not an admin/service-account key
FIREBASE_WEB_API_KEY=

# Rotation only: keep the old master until old sessions expire and MFA is verified.
SESSION_SECRET_PREVIOUS=
# Leave blank: older verified credentials still enter the password upgrade flow.
# A future cutoff is YYYY-MM-DD at midnight UTC and requires owner approval.
LEGACY_PASSWORD_CUTOFF=
# Signup only. An empty list allows verified non-disposable addresses.
ALLOWED_EMAIL_DOMAINS=
# Render currently uses one trusted proxy hop. Local development defaults to zero.
# TRUST_PROXY_HOPS=1
# Fixed-window per-account attempt budgets, in addition to existing IP limits.
ARTICLES_PER_ACCOUNT_DAY=8
COMMENTS_PER_ACCOUNT_HOUR=12
UPLOADS_PER_ACCOUNT_DAY=12
INITIAL_COMMENTS_TO_REVIEW=2
# Applies to database-backed images. The default is 64 MiB.
MEDIA_QUOTA_BYTES=67108864
